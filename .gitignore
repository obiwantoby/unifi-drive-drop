# session + credentials — never commit
.token
*.token
jar.txt
cookies*.txt
.env

# build output
apps/macos/.build/
apps/macos/build/
apps/windows/target/
*.app/

# Captured console responses: these are what leaked (device MACs, users, serials). The spec is the
# product, not the captures — see tools/check-pii.sh, which fails CI if any of this is tracked.
spec/raw/
*.jsonl

# scratch
/tmp/
.DS_Store

# python
__pycache__/
*.pyc

# operator-specific PII substitutions; keep local, the repo ships the mechanism only
tools/pii.json

# Rendered icon intermediates; the .icns is committed so a clone needs no Xcode just to brand the bundle.
apps/macos/resources/AppIcon.iconset/

# Release artifacts are published to GitHub Releases, not committed.
apps/macos/dist/

# Rust build output, at any depth (apps/windows, apps/windows-ui, ...)
target/

# Window captures taken by tools/shot*.ps1 while driving the UI. They are evidence, not source,
# and they can contain whatever was on screen - including a real console address.
/*.png
/*.png-*.png
