# session + credentials — never commit
.token
*.token
jar.txt
cookies*.txt
.env

# build output
apps/macos/.build/
apps/macos/build/
apps/windows/target/
*.app/

# captured responses are intentional, but not the scratch ones
/tmp/
.DS_Store

# python
__pycache__/
*.pyc

# operator-specific PII substitutions; keep local, the repo ships the mechanism only
tools/pii.json

# Rendered icon intermediates; the .icns is committed so a clone needs no Xcode just to brand the bundle.
apps/macos/resources/AppIcon.iconset/

# Release artifacts are published to GitHub Releases, not committed.
apps/macos/dist/

# Rust build output, at any depth (apps/windows, apps/windows-ui, ...)
target/
